                <td style={{ padding: "10px" }}>
                  <span
                    style={{
                      padding: "3px 8px",
                      backgroundColor:
                        profile.role === "ADMIN" ? "#dc3545" : "#17a2b8",
                      color: "white",
                      borderRadius: "12px",
                      fontSize: "0.9em",
                    }}
                  >
                    {profile.role}
                  </span>
                </td>
                <td style={{ padding: "10px" }}>
                  {new Date(profile.created_at).toLocaleString("pl-PL")}
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  );
};
